# Publisher is always enabled: there is no PUBLISHER_ENABLED variable.
# This is the same public origin as PUBLIC_API_BASE_URL / FRONTEND_URL.
# Used to generate /static/adManager.js URL in Publisher ad-code responses.
PUBLISHER_PUBLIC_URL=https://twinbid.io

# Existing Redis service used by ADV, isolated by logical DB on port 7005.
# DBs 5,6,7 belong to advertiser runtime, winner and percenter respectively.
# DB 8 is not assigned in supplied RTB files: verify it is empty and reserve it.
PUBLISHER_REDIS_ADDRS=buffer.twinbidexchange.com:7005
PUBLISHER_REDIS_DB=8
PUBLISHER_REDIS_CLUSTER=false
PUBLISHER_REDIS_USERNAME=
PUBLISHER_REDIS_TLS=false
# On this exact host, Redis password is inherited from REDIS_PASSWORD in api.env.
# Optionally set PUBLISHER_REDIS_PASSWORD only for independent credentials.

# Optional (defaults are already in the code):
# PUBLISHER_PUBLIC_SCRIPT_URL=https://twinbid.io/static/adManager.js
# PUBLISHER_SYNC_INTERVAL=2s
# PUBLISHER_REVENUE_SYNC_INTERVAL=30s
# PUBLISHER_REVENUE_SYNC_TIMEOUT=30s
