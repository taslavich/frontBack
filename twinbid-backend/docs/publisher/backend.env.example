# Existing advertiser/POP recovery variables remain unchanged.
PUBLISHER_ENABLED=true
PUBLISHER_PUBLIC_URL=https://pub.example.com
# Mandatory when PUBLISHER_ENABLED=true. Use the existing Redis host (DB 0); no separate instance is required.
PUBLISHER_REDIS_ADDRS=redis.example.internal:6379
PUBLISHER_REDIS_CLUSTER=false
PUBLISHER_REDIS_USERNAME=
PUBLISHER_REDIS_PASSWORD=
PUBLISHER_REDIS_TLS=false
PUBLISHER_SYNC_INTERVAL=2s

PUBLISHER_REVENUE_SYNC_INTERVAL=30s
PUBLISHER_REVENUE_SYNC_TIMEOUT=30s
