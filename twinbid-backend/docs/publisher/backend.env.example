# Publisher is always enabled; PUBLISHER_ENABLED has been removed.
# API / SDK public HTTPS origin (replace with your deployed domain).
PUBLISHER_PUBLIC_URL=https://pub.example.com

# Reuse the existing standalone Redis server; no new Redis instance.
PUBLISHER_REDIS_ADDRS=buffer.twinbidexchange.com:7005
# EXAMPLE ONLY: verify and reserve DB 6 before enabling writes; never use advertiser DB 5.
# Matching PUBLISHER_REDIS_DB is required in the RTB Publisher Server when deployed.
PUBLISHER_REDIS_DB=6
PUBLISHER_REDIS_CLUSTER=false
# Set these only if your existing Redis requires authentication/TLS.
PUBLISHER_REDIS_USERNAME=
PUBLISHER_REDIS_PASSWORD=
PUBLISHER_REDIS_TLS=false

# Optional; keep current defaults unless there is an operational reason to tune.
PUBLISHER_SYNC_INTERVAL=2s
PUBLISHER_REVENUE_SYNC_INTERVAL=30s
PUBLISHER_REVENUE_SYNC_TIMEOUT=30s
# PUBLISHER_PUBLIC_SCRIPT_URL= (optional full HTTPS SDK script URL)
