# Telegram payment moderation. Both values are mandatory.
# BOT_ADMIN_USER_ID is the users.id UUID of the account used by the bot to obtain its JWT.
BOT_INTERNAL_SECRET=replace_with_a_long_random_secret
BOT_ADMIN_USER_ID=00000000-0000-0000-0000-000000000000

# PassimPay Invoice Link integration.
# Leave PLATFORM_ID/API_KEY empty only when the PassimPay channel must remain disabled.
PASSIMPAY_BASE_URL=https://api.passimpay.io
PASSIMPAY_PLATFORM_ID=0
PASSIMPAY_API_KEY=
PASSIMPAY_CREATE_INVOICE_PATH=/v2/createorder
PASSIMPAY_CHECK_INVOICE_PATH=/v3/orderstatus
PASSIMPAY_INVOICE_TYPE=1
# Optional comma-separated PassimPay currency IDs. Empty means the provider page decides what is available.
PASSIMPAY_CURRENCY_IDS=
PASSIMPAY_TIMEOUT=10s
PASSIMPAY_RECONCILE_INTERVAL=5m
PASSIMPAY_RECONCILE_BATCH_SIZE=20
PASSIMPAY_RECONCILE_REQUEST_DELAY=150ms
PASSIMPAY_RECONCILE_RETRY_DELAY=5m

# Configure this URL as the Notification URL in the PassimPay platform settings:
# https://api.twinbidexchange.com/api/webhooks/passimpay
