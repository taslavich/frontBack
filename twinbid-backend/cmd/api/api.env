# HTTP
HTTP_HOSTNAME=0.0.0.0
HTTP_PORT=8080

# PostgreSQL
POSTGRES_DSN=postgres://user:pass@127.0.0.1:5432/twinbid?sslmode=disable

# Auth
JWT_SECRET=change-me-super-secret
ACCESS_TOKEN_TTL=15
REFRESH_TOKEN_TTL=720

# Frontend CORS origin
FRONTEND_URL=https://twinbid.io

# S3 (AWS S3 or S3-compatible like MinIO)
AWS_REGION=us-east-1
S3_BUCKET=creatives
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_SESSION_TOKEN=
S3_UPLOAD_URL_TTL_SECONDS=900
S3_DOWNLOAD_URL_TTL_SECONDS=900